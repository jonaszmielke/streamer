generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

model User {
  id           String   @id @default(uuid())
  name         String   @unique
  email        String   @unique
  password     String
  tempPassword Boolean  @default(true)
  role         Role     @default(USER)
  lastActive   DateTime @default(now())
  createdAt    DateTime @default(now())
}
